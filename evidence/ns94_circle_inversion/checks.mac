kill(all)$
checks:0$
check(name,expr):=block([v:ratsimp(expr)],if v#0 then error(name,v),checks:checks+1,print("PASS",name))$
inv(x,y,c,r):=[c+r^2*(x-c)/((x-c)^2+y^2),r^2*y/((x-c)^2+y^2)]$
powpt(v,m,rr):=(v[1]-m)^2+v[2]^2-rr$
v:inv(x,y,c,r)$ m:c+r^2/(2*(a-c))$
check("general power",powpt(v,m,r^4/(4*(a-c)^2))-r^4*(a-x)/((a-c)*((x-c)^2+y^2)))$
v:inv(a,y,c,r)$ check("critical line circle",powpt(v,m,r^4/(4*(a-c)^2)))$
v:inv(x,y,a-p,p)$
check("left power",powpt(v,a-p/2,p^2/4)-p^3*(a-x)/((x-a+p)^2+y^2))$
w:inv(x,y,a+q,q)$
check("right power",powpt(w,a+q/2,q^2/4)-q^3*(x-a)/((x-a-q)^2+y^2))$
check("nonnegative product",-powpt(v,a-p/2,p^2/4)*powpt(w,a+q/2,q^2/4)/(p^3*q^3)-(x-a)^2/(((x-a+p)^2+y^2)*((x-a-q)^2+y^2)))$
ee:ratsimp(((p/2)*(a+q/2)-(q/2)*(a-p/2))/((p-q)/2))$
check("exterior centre",ee-a-p*q/(p-q))$
check("homothety",ee+(q/p)*(a-p/2-ee)-(a+q/2))$
check("shrink path finite a",subst([p=t,q=2*t],ee)-(a-2*t))$
check("shrink path finite a-1",subst([p=t,q=t+t^2],ee)-(a-1-t))$
check("shrink path infinite",subst([p=t,q=t+t^3],ee)-(a-1/t-t))$
v:inv(x,y,a-p,p)$ w:inv(v[1],v[2],a+q,q)$
k:1/p+1/q$ den:(1+k*(x-a))^2+k^2*y^2$
check("composition real",w[1]-a-((x-a)*(1+k*(x-a))+k*y^2)/den)$
check("composition imaginary",w[2]-y/den)$
v:inv(a,y,a-p,p)$ w:inv(v[1],v[2],a+q,q)$
check("composition circle",powpt(w,a+1/(2*k),1/(4*k^2)))$
v:inv(a,y,a+q,q)$ w:inv(v[1],v[2],a-p,p)$
check("reverse circle",powpt(w,a-1/(2*k),1/(4*k^2)))$
poly:((s-1/2-1/4)^2+1)*((s-1/2+1/4)^2+1)$
check("reflection symmetry",subst(1-s,s,poly)-poly)$
for root in [1/4+%i,1/4-%i,3/4+%i,3/4-%i] do check("quartet root",subst(root,s,poly))$
insideL:0$ insideR:0$
for xx in [1/4,3/4] do for yy in [-1,1] do block([pl,pr],
 pl:ratsimp(powpt(inv(xx,yy,0,1/2),1/4,1/16)),
 pr:ratsimp(powpt(inv(xx,yy,1,1/2),3/4,1/16)),
 if pl<0 then insideL:insideL+1,
 if pr<0 then insideR:insideR+1,
 if pl=0 or pr=0 then error("unexpected boundary root"))$
check("two inside left",insideL-2)$ check("two inside right",insideR-2)$
check("inward radius coefficient",limit((1/2-r)*r^2/(2*(1/2-r)),r,1/2,minus)-1/8)$
check("outward radius limit",limit(r^2/(2*(1/2+r)),r,1/2)-1/8)$
print("PASS:",checks,"exact checks")$
quit()$
